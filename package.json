{
  "name": "opentake",
  "productName": "OpenTake",
  "version": "1.1.0",
  "description": "A free desktop recording studio: mic cleanup, camera look and lighting, screen and camera recording with auto zoom, and a teleprompter. Everything runs on your computer.",
  "main": "out/main/index.js",
  "homepage": "https://quetzaltech.app/tools/take",
  "repository": {
    "type": "git",
    "url": "https://github.com/Svrubio7/Opentake.git"
  },
  "author": "Quetzal <hello@quetzaltech.app>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "node scripts/build-mcp.mjs && electron-vite dev",
    "build": "electron-vite build && node scripts/build-mcp.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "keywords": [
    "recording",
    "screen-recorder",
    "teleprompter",
    "microphone",
    "webcam",
    "electron"
  ],
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "geist": "^1.8.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uiohook-napi": "^1.5.5",
    "vosk-browser": "^0.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
