{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "paths": { "@shared/*": ["./src/shared/*"], "@core/*": ["./src/renderer/core/*"] }
  },
  "include": ["src", "electron.vite.config.ts"]
}
